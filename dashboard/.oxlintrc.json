{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "ignorePatterns": ["node_modules/**"],
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/ban-ts-comment": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "(^@base-ui/|^@radix-ui/|(^|/)shadcn/|(^|/)components/ui/)",
            "message": "Use the public @/ui adapter instead of component-vendor imports."
          }
        ]
      }
    ],
    "typescript/no-deprecated": "error",
    "no-nested-ternary": "error"
  },
  "overrides": [
    {
      "files": [
        "src/features/*/model.ts",
        "src/features/memory/library-state.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^react($|/)|^react-dom($|/)|^lucide-react$|^@base-ui/|^@radix-ui/|(^|/)(ui|views|dev|components|infrastructure)(/|$)|(^|/)use-[^/]+$)",
                "message": "Pure memory models and state must not depend on React, views, component libraries, or development sources."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "localStorage",
          "fetch"
        ]
      }
    },
    {
      "files": ["src/features/*/use-*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^react-dom($|/)|^lucide-react$|^@base-ui/|^@radix-ui/|(^|/)(ui|views|dev|components|infrastructure)(/|$))",
                "message": "View models use injected ports, never UI components, mock data, or concrete transports."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "localStorage",
          "fetch"
        ]
      }
    },
    {
      "files": ["src/features/*/views/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^@base-ui/|^@radix-ui/|(^|/)shadcn/|(^|/)components/ui/|(^|/)(dev|infrastructure)(/|$))",
                "message": "Views use injected view models and the public UI adapter, never concrete transports or mock fixtures."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "fetch",
          "localStorage",
          "XMLHttpRequest",
          "WebSocket"
        ]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)(features|dev|infrastructure)(/|$)",
                "message": "The UI adapter must remain independent of application features and mock data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/infrastructure/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^react($|/)|^react-dom($|/)|^lucide-react$|^@base-ui/|^@radix-ui/|(^|/)(ui|views|dev|components)(/|$)|(^|/)use-[^/]+$)",
                "message": "Transport adapters depend on contracts, never React state, UI, or mocks."
              }
            ]
          }
        ]
      }
    }
  ]
}
